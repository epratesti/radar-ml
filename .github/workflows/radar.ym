name: Radar ML
on:
  schedule:
    - cron: "0 */3 * * *"   # a cada 3 horas (horário UTC)
  workflow_dispatch:         # permite rodar manualmente
permissions:
  contents: write
concurrency: radar
jobs:
  rodar:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install -r requirements.txt
      - run: python bot.py
        env:
          TELEGRAM_TOKEN: ${{ secrets.TELEGRAM_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          ML_CLIENT_ID: ${{ secrets.ML_CLIENT_ID }}
          ML_CLIENT_SECRET: ${{ secrets.ML_CLIENT_SECRET }}
          ML_AFFILIATE_ID: "71970283"
      - name: Salvar dados
        run: |
          git config user.name "radar-bot"
          git config user.email "radar-bot@users.noreply.github.com"
          git add docs/trends.json state/posted.json
          git diff --cached --quiet || (git commit -m "Atualiza tendências" && git push)
